# =============================================================================
# OntologyService - local docker environment
# =============================================================================
# Copy this file to `.env` - every value below is a working
# LOCAL default. The passwords are deliberately simple and are intended
# ONLY for local use, never for a deployed environment.
#
# IMAGE_BASE_PATH points at the Gaeco Azure Container Registry - log in with
# `az acr login --name crgaeco001` (or change it to your own registry) before the first start.
# =============================================================================

# =============================================================================
# IMAGE TAGS
# =============================================================================
ONTOLOGY_SERVER_TAG=latest

# =============================================================================
# GLOBAL SETTINGS
# =============================================================================
ASPNETCORE_ENVIRONMENT=Development
IMAGE_BASE_PATH=crgaeco001.azurecr.io

# =============================================================================
# ASPIRE DASHBOARD (Monitoring)
# =============================================================================
OTLP_ENDPOINT=http://gaeco-monitor-aspire:18889

# =============================================================================
# KAFKA (Message Broker)
# =============================================================================
KAFKA_ADDRESS=gaeco-broker:29092

# --- Kafka Consumer Settings
KAFKA_AUTO_OFFSET_RESET=Earliest
KAFKA_SESSION_TIMEOUT_MS=150000
KAFKA_MAX_POLL_INTERVAL_MS=1500000

# --- Kafka Topics
KAFKA_TOPICS_ONTOLOGY=ekkodale.gaeco.ontology.public.uploaded

# =============================================================================
# MINIO (Object Storage)
# =============================================================================
MINIO_ADDRESS=gaeco-minio:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# =============================================================================
# KEYCLOAK (Authentication)
# =============================================================================
KEYCLOAK_SERVER_HOSTNAME=localhost:9345
KEYCLOAK_REALM=gaeco

# =============================================================================
# ONTOLOGY SERVICE
# =============================================================================
# --- Ontology Service Postgres
ONTOLOGY_POSTGRES_DATABASE=OntologyServiceDB
ONTOLOGY_POSTGRES_USER=OntologyService
ONTOLOGY_POSTGRES_PASSWORD=ontology-local-pw

# --- Ontology Service Server
ONTOLOGY_SERVER_HOSTNAME=localhost:5023
ALLOWED_CORS_ORIGIN=http://localhost:5000

# =============================================================================
# LOCAL DEVELOPMENT ONLY
# Die folgenden Variablen werden in deployed Umgebungen vom Orchestrator
# injiziert und sind ausschliesslich fuer den lokalen Docker-Compose-Betrieb
# benoetigt.
# =============================================================================
STACK_NAME=ontology
ENVIRONMENT_NETWORK=gaeco-local
TRAEFIK_NETWORK=traefik-proxy
VOLUME_BASE_PATH=./volumes

# --- Override (Port-Bindings)
ONTOLOGY_POSTGRES_OUTERPORT=5025
ONTOLOGY_SERVER_OUTERPORT=5023
